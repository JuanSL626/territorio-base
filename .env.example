# territorio-base — variables de entorno
#
# Copiá este archivo a `.env` en la raíz del repo. `.env` está en .gitignore;
# este ejemplo no. Nunca pongas un secreto real acá.
#
#     cp .env.example .env
#
# Quién lee qué:
#
#   · Las de la sección "Aplicación web" las valida zod en
#     `packages/db/src/env.ts`. Si falta una o está mal, el proceso falla al
#     arrancar con la lista completa de variables problemáticas — no con un
#     `undefined` tres capas más abajo.
#   · Las de "Servicio raster" las lee `services/api/src/territorio_base_api/
#     config.py` directamente, con defaults propios. Todas son opcionales.
#   · Las de "Docker Compose" las interpola `compose.yaml`. No las lee ningún
#     proceso de la app.
#
# Docker Compose carga este `.env` solo, y además pisa `API_URL` y
# `DATABASE_URL` con los valores que corresponden adentro de la red de
# contenedores. No hace falta editarlos para desplegar.


# Aplicación web (apps/web + packages/db)

# --- Autenticación ---

# Clave de firma de las sesiones y de todo lo demás que Better Auth firma.
# Mínimo 32 caracteres. Generala así:
#
#     openssl rand -base64 32
#
# Cambiarla invalida todas las sesiones activas. OBLIGATORIA: no tiene default,
# a propósito — un default sería una clave pública en un repo.
BETTER_AUTH_SECRET=

# Origen público de la app web. De acá salen los orígenes de confianza y, en
# producción, el atributo `Secure` de la cookie de sesión. Detrás de un proxy
# con TLS tiene que ser la URL PÚBLICA (`https://mapa.ejemplo.org`), no
# `http://web:3000`, o el login falla con un error de origen.
BETTER_AUTH_URL=http://localhost:3000


# --- Base de datos ---

# Archivo SQLite. El prefijo `file:` es opcional. Las rutas relativas se
# resuelven contra la RAÍZ DEL REPO (no contra el cwd), así que apunta al mismo
# archivo la corras desde donde la corras. En producción, usá una ruta absoluta
# (compose usa `file:/data/territorio.db`, dentro del volumen).
DATABASE_URL=file:./data/territorio.db


# --- Servicio de raster (services/api) ---

# URL base del FastAPI en Python que hace STAC, NDVI, pendiente y WorldCover.
# La usa el SERVIDOR (SSR), así que puede ser un nombre interno: bajo compose
# vale `http://api:8787` y compose ya lo setea.
#
# El puerto es 8787 en todos lados —`services/api`, `apps/web`, este archivo y
# `packages/db/src/env.ts`— desde que se unificó. Si ves 8000 en algún lugar,
# es un resto viejo: es un bug, no una convención.
API_URL=http://localhost:8787

# Token interno OPCIONAL. Si lo ponés, tiene que coincidir con
# `TERRITORIO_API_TOKEN` (más abajo) y el servicio raster exige
# `Authorization: Bearer …` en todo menos `/healthz`.
#
# Efecto secundario que hay que conocer antes de activarlo: con token, las URLs
# absolutas de los PNG de overlay dejan de funcionar desde el navegador (darían
# 401) y hay que proxearlas por una ruta del servidor. Ver
# `apps/web/src/lib/api.ts`, `publicRasterBaseUrl()`. Vacío = sin autenticación,
# que es lo correcto cuando el servicio no sale de la red de contenedores.
API_TOKEN=

# Base ABSOLUTA que el NAVEGADOR usa para pedir los PNG de overlay directo al
# servicio raster (el resto del tráfico va por las server functions del SSR).
#
# Es BUILD-TIME, no runtime: Vite la hornea en el bundle del cliente, así que
# cambiarla exige reconstruir (`docker compose build web`). Vacía en desarrollo:
# `raster-base.ts` cae a `http://localhost:8787`.
VITE_API_URL=


# --- Bootstrap del primer administrador ---
#
# Las lee SOLO `pnpm --filter @territorio/db db:seed`. Podés borrarlas del .env
# una vez creado el usuario.
#
#     pnpm --filter @territorio/db db:migrate
#     pnpm --filter @territorio/db db:seed -- --name "Tu Nombre"
#
# El seed no escribe el usuario a mano: emite una invitación a nombre de
# ADMIN_EMAIL y la canjea por el mismo camino que cualquier otra persona. No hay
# puerta trasera, ni siquiera para el primer usuario.
ADMIN_EMAIL=
# Mínimo 12 caracteres para la cuenta de bootstrap (el mínimo general de la app
# es 8). Cambiala después del primer inicio de sesión.
ADMIN_PASSWORD=


# Servicio raster (services/api) — todas opcionales

# Dónde viven los jobs, sus GeoTIFF y la caché de los COG de WRI Aqueduct.
# En Docker es `/data`, el volumen que comparte con la app web; el Dockerfile ya
# lo fija y no hace falta tocarlo acá.
TERRITORIO_DATA_DIR=./data

# Orígenes que pueden pedir overlays desde el navegador, separados por comas.
# Tiene que incluir la URL PÚBLICA de la app web. El servicio expone `X-Bounds`
# a propósito para que el cliente pueda ubicar el PNG en el mapa.
TERRITORIO_CORS_ORIGINS=http://localhost:3000

# El otro lado de `API_TOKEN`. Vacío = sin autenticación.
TERRITORIO_API_TOKEN=

# Análisis en paralelo. Cada uno descarga y mosaica escenas Sentinel-2: subirlo
# sube la RAM y el ancho de banda, no la velocidad de un análisis individual.
# El servicio corre con UN worker de uvicorn a propósito (el store de jobs vive
# en el proceso), así que este número es la única palanca de escala.
TERRITORIO_MAX_CONCURRENT_JOBS=2

# Horas que sobrevive un job antes de que la purga de arranque lo borre, con
# sus GeoTIFF. Bajarlo es la forma de controlar el tamaño del volumen.
TERRITORIO_JOB_TTL_HOURS=72

# Trazas y errores detallados en las respuestas. NUNCA en producción.
TERRITORIO_DEBUG=0


# Docker Compose — solo interpolación, no las lee ningún proceso

# Puertos que compose publica en el host. Cambialos si 3000 u 8787 ya están
# ocupados; los puertos INTERNOS de los contenedores no cambian.
WEB_PORT=3000
API_PORT=8787

# La URL con la que el NAVEGADOR alcanza al servicio raster. Compose se la pasa
# al build de la imagen web como `VITE_API_URL`. Detrás de un proxy inverso
# suele ser algo como `https://mapa.ejemplo.org/raster`.
PUBLIC_API_URL=http://localhost:8787
