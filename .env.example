# territorio-base — variables de entorno
#
# Copiá este archivo a `.env` en la raíz del repo. `.env` está en .gitignore;
# este ejemplo no. Nunca pongas un secreto real acá.
#
#     cp .env.example .env
#
# Quién lee qué:
#
#   · `DATABASE_URL` la valida zod en `packages/db/src/env.ts` — falla al
#     arrancar con un mensaje claro si falta o tiene la forma equivocada, no
#     con un `undefined` tres capas más abajo. Las `VITE_SUPABASE_*` y
#     `SUPABASE_SERVICE_ROLE_KEY` las lee/valida el módulo que arma el
#     cliente de Supabase Auth en `apps/web` (ver `docs/supabase/`).
#   · Las de "Servicio raster" las lee `services/api/src/territorio_base_api/
#     config.py` directamente, con defaults propios. Todas son opcionales.
#   · Las de "Docker Compose" las interpola `compose.yaml`. No las lee ningún
#     proceso de la app.
#
# Docker Compose carga este `.env` solo, y pisa `API_URL` con el nombre de
# servicio interno (`http://api:8787`). `DATABASE_URL` y las
# `VITE_SUPABASE_*`/`SUPABASE_SERVICE_ROLE_KEY` NO las pisa: son un proyecto
# Supabase externo de verdad, en desarrollo y detrás de compose — hay que
# completarlas para que cualquiera de los dos arranque.


# Aplicación web (apps/web + packages/db)

# --- Supabase ---
#
# Proyecto Supabase (Postgres + Auth). Sacás estos tres valores de
# Project Settings → API / Data API en el dashboard de Supabase (o
# `supabase status` con el stack local).

# URL pública del proyecto (`https://<project-ref>.supabase.co`, o
# `http://localhost:54321` con el stack local de `supabase start`). Va al
# BROWSER — la usa el cliente de Supabase Auth del lado del cliente, así que
# NUNCA lleva un secreto.
VITE_SUPABASE_URL=

# Clave pública ("publishable"/anon) del proyecto. También va al browser — es
# segura de exponer PORQUE la única protección real de los datos es RLS
# (activado, sin políticas, en `packages/db/src/schema.ts`) más el hecho de
# que ningún cliente en el browser habla con Postgres directo en esta app.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clave de rol de servicio. SECRETA — SOLO EL SERVIDOR. Nunca le pongas el
# prefijo `VITE_` a esta variable ni la referencies desde código que Vite
# empaqueta para el browser: esta clave salta RLS por completo. La usa
# server-side lo que la migración de auth necesite (ej. `inviteUserByEmail`
# vía el admin API de GoTrue) — no `packages/db`, que solo abre la conexión
# de `DATABASE_URL` de abajo.
SUPABASE_SERVICE_ROLE_KEY=


# --- Base de datos (packages/db) ---

# Cadena de conexión de Postgres para Drizzle (`postgres-js`), NO un archivo
# SQLite. Sacala de Project Settings → Database → Connection string en el
# dashboard de Supabase. Formas válidas, según el pooler:
#
#   Supavisor, modo SESSION (puerto 5432, host `*.pooler.supabase.com`):
#   recomendada para este servidor SSR — un proceso Node de larga vida que
#   mantiene una sola conexión (o un pool chico). Soporta prepared
#   statements, que `client.ts` deja encendidos (el default de postgres-js).
#
#       DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Supavisor, modo TRANSACTION (puerto 6543): pensado para serverless/edge,
#   muchas conexiones cortas — NO es el patrón de este repo. Si alguna vez se
#   usa, `client.ts` necesita `postgres(url, { prepare: false })`, que hoy no
#   tiene puesto.
#
# Conexión directa (puerto 5432, host `db.<project-ref>.supabase.co`) es una
# tercera opción, con menor latencia, pero necesita salida IPv6 del host.
#
# Ver `packages/db/README.md` para el detalle completo.
DATABASE_URL=


# --- Servicio de raster (services/api) ---

# URL base del FastAPI en Python que hace STAC, NDVI, pendiente y WorldCover.
# La usa el SERVIDOR (SSR), así que puede ser un nombre interno: bajo compose
# vale `http://api:8787` y compose ya lo setea.
#
# El puerto es 8787 en todos lados —`services/api`, `apps/web`, este archivo,
# `compose.yaml`. Si ves 8000 en algún lugar, es un bug, no una convención.
API_URL=http://localhost:8787

# Token interno OPCIONAL. Si lo ponés, tiene que coincidir con
# `TERRITORIO_API_TOKEN` (más abajo) y el servicio raster exige
# `Authorization: Bearer …` en todo menos `/healthz`. El SSR lo agrega tanto
# en las server functions como en el proxy de overlays
# (`apps/web/src/routes/api/raster.*.ts`), así que el navegador nunca
# necesita conocerlo. Vacío = sin autenticación de servicio a servicio; igual
# sigue habiendo sesión + chequeo de dueño en el proxy (no es "sin
# autenticación" a secas), así que vacío es razonable cuando `api` no sale de
# la red de contenedores — el default de `compose.yaml` (puerto no publicado).
API_TOKEN=


# No hay sección de "bootstrap del primer administrador" acá: no hay script
# propio que crear un usuario. El primer usuario (y cualquier otro) se crea
# invitando desde el dashboard de Supabase (Authentication → Users → Invite)
# o con `supabase.auth.admin.inviteUserByEmail()` desde la Admin API —
# ver README, "Primer usuario", y `docs/supabase/02-auth-invitaciones.md`.
# En local, Mailpit (`http://127.0.0.1:54324`) muestra el email de invitación
# sin salir a internet.


# Servicio raster (services/api) — todas opcionales

# Dónde viven los jobs, sus GeoTIFF y la caché de los COG de WRI Aqueduct.
# En Docker es `/data`, el volumen que monta el servicio `api` (ya no `web`:
# no le queda nada propio que guardar ahí — ver `compose.yaml`); el
# Dockerfile de `api` ya lo fija y no hace falta tocarlo acá.
TERRITORIO_DATA_DIR=./data

# Orígenes que pueden pedir overlays desde el navegador, separados por comas.
# Tiene que incluir la URL PÚBLICA de la app web. El servicio expone `X-Bounds`
# a propósito para que el cliente pueda ubicar el PNG en el mapa.
TERRITORIO_CORS_ORIGINS=http://localhost:3000

# El otro lado de `API_TOKEN`. Vacío = sin autenticación.
TERRITORIO_API_TOKEN=

# Análisis en paralelo. Cada uno descarga y mosaica escenas Sentinel-2: subirlo
# sube la RAM y el ancho de banda, no la velocidad de un análisis individual.
# El servicio corre con UN worker de uvicorn a propósito (el store de jobs vive
# en el proceso), así que este número es la única palanca de escala.
TERRITORIO_MAX_CONCURRENT_JOBS=2

# Horas que sobrevive un job antes de que la purga de arranque lo borre, con
# sus GeoTIFF. Bajarlo es la forma de controlar el tamaño del volumen.
TERRITORIO_JOB_TTL_HOURS=72

# Trazas y errores detallados en las respuestas. NUNCA en producción.
TERRITORIO_DEBUG=0


# Docker Compose — solo interpolación, no las lee ningún proceso

# Puerto que compose publica en el host para `web`. Cambialo si 3000 ya está
# ocupado; el puerto INTERNO del contenedor no cambia. `api` (8787) ya NO se
# publica al host — el navegador no le habla directo, ver `compose.yaml`.
WEB_PORT=3000

# URL PÚBLICA de esta app (con el proxy TLS delante en producción, ej.
# `https://mapa.ejemplo.org`; `http://localhost:3000` alcanza en local).
# `compose.yaml` la usa como default de `TERRITORIO_CORS_ORIGINS` del
# servicio raster — tiene que ser el origen que ve el NAVEGADOR, no
# `http://web:3000` (el nombre interno de compose).
WEB_PUBLIC_URL=http://localhost:3000
