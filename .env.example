# territorio-base — variables de entorno
#
# Copiá este archivo a `.env` en la raíz del repo. `.env` está en .gitignore;
# este ejemplo no. Nunca pongas un secreto real acá.
#
#     cp .env.example .env
#
# El contrato lo valida zod en `packages/db/src/env.ts`. Si falta algo o está
# mal, el proceso falla al arrancar con la lista completa de variables
# problemáticas — no con un `undefined` tres capas más abajo.


# ─── Autenticación ───────────────────────────────────────────────────────────

# Clave de firma de las sesiones y de todo lo demás que Better Auth firma.
# Mínimo 32 caracteres. Generala así:
#
#     openssl rand -base64 32
#
# Cambiarla invalida todas las sesiones activas. OBLIGATORIA: no tiene default,
# a propósito — un default sería una clave pública en un repo.
BETTER_AUTH_SECRET=

# Origen público de la app web. De acá salen los orígenes de confianza y, en
# producción, el atributo `Secure` de la cookie de sesión.
# Default: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000


# ─── Base de datos ───────────────────────────────────────────────────────────

# Archivo SQLite. El prefijo `file:` es opcional. Las rutas relativas se
# resuelven contra la RAÍZ DEL REPO (no contra el cwd), así que apunta al mismo
# archivo la corras desde donde la corras. En producción, usá una ruta absoluta.
# Default: file:./data/territorio.db
DATABASE_URL=file:./data/territorio.db


# ─── Servicio de raster (services/api) ───────────────────────────────────────

# URL base del FastAPI en Python que hace STAC, NDVI, pendiente y WorldCover.
# Default: http://localhost:8000
API_URL=http://localhost:8000


# ─── Bootstrap del primer administrador ──────────────────────────────────────
#
# Las lee SOLO `pnpm --filter @territorio/db db:seed`. Podés borrarlas del .env
# una vez creado el usuario.
#
#     pnpm --filter @territorio/db db:migrate
#     pnpm --filter @territorio/db db:seed -- --name "Tu Nombre"
#
# El seed no escribe el usuario a mano: emite una invitación a nombre de
# ADMIN_EMAIL y la canjea por el mismo camino que cualquier otra persona. No hay
# puerta trasera, ni siquiera para el primer usuario.
ADMIN_EMAIL=
# Mínimo 12 caracteres para la cuenta de bootstrap (el mínimo general de la app
# es 8). Cambiala después del primer inicio de sesión.
ADMIN_PASSWORD=
