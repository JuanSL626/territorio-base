# Catalogs live in pnpm-workspace.yaml; packages reference them with "catalog:".
# Anything installed with `pnpm add` should still land as an exact version so the
# catalog stays the only place a range can hide.
save-exact=true

# Workspace wiring
link-workspace-packages=deep
prefer-workspace-packages=true
shared-workspace-lockfile=true

# Peers: do NOT silently invent peer installs. Declare them.
auto-install-peers=false
strict-peer-dependencies=false
dedupe-peer-dependents=true

# Node 24 is a hard requirement (TanStack Start >=22.12, @vitejs/plugin-react >=22.12).
engine-strict=true
